// Complex showcase: Employee Management System
// Exercises: classes, interfaces, string interpolation,
// arrays, maps, result types, match, for-in, compound assignment, borrowing

// --- Interface ---
interface Displayable {
    fn to_string(&self) -> string;
    fn display(&self);
}

// --- Classes ---
class Employee {
    name: string
    id: int = 0
    salary: float = 0.0
    department: string
}

impl Displayable for Employee {
    fn to_string(&self) -> string {
        return f"Employee({self.name}, #{self.id}, {self.department})";
    }
    fn display(&self) {
        println(f"  {self.name} (ID: {self.id}) - {self.department} - ${self.salary}");
    }
}

// --- Functions ---
fn create_employee(name: string, id: int, dept: string, salary: float) -> Employee {
    let emp = new Employee;
    emp.name = name;
    emp.id = id;
    emp.department = dept;
    emp.salary = salary;
    return emp;
}

fn total_payroll(a: float, b: float, c: float, d: float, e: float) -> float {
    return a + b + c + d + e;
}

fn apply_bonus(salary: float, bonus: float) -> float {
    return salary + (salary * bonus);
}

// --- Main ---
println("=== Employee Management System ===");
println("");

// Create employees
let emp1 = create_employee("Alice", 1, "Engineering", 95000.0);
let emp2 = create_employee("Bob", 2, "Engineering", 87000.0);
let emp3 = create_employee("Charlie", 3, "Marketing", 72000.0);
let emp4 = create_employee("Diana", 4, "Marketing", 78000.0);
let emp5 = create_employee("Eve", 5, "Engineering", 105000.0);

// Display individual employees (tests Bug 1: string fields in methods)
println("--- Employees ---");
emp1.display();
emp2.display();
emp3.display();
emp4.display();
emp5.display();
println("");

// Calculate payroll
let payroll = total_payroll(95000.0, 87000.0, 72000.0, 78000.0, 105000.0);
println(f"Total payroll: ${payroll}");
println("");

// Interface usage (tests Bug 1: self.field in interface impl)
let item: &Displayable = &emp1 as &Displayable;
item.display();
println("");

// to_string via interface
let str_repr = emp1.to_string();
println(f"Employee repr: {str_repr}");
println("");

// String interpolation with expressions
let avg = payroll / 5;
println(f"Average salary: ${avg}");
println("");

// Closure
let bonus_salary = apply_bonus(95000.0, 0.1);
println(f"Salary with 10% bonus: ${bonus_salary}");
println("");

// Map usage
let roles = {"alice": "Senior Engineer", "bob": "Engineer", "charlie": "Manager"};
println("--- Roles ---");
let alice_role = roles["alice"];
println(f"  alice: {alice_role}");
let bob_role = roles["bob"];
println(f"  bob: {bob_role}");
let charlie_role = roles["charlie"];
println(f"  charlie: {charlie_role}");
println(f"  Total roles: {len(roles)}");
println("");

// Result type with match
fn find_employee_by_id(id: int) {
    if id == 1 {
        return Ok("Alice");
    }
    if id == 2 {
        return Ok("Bob");
    }
    if id == 3 {
        return Ok("Charlie");
    }
    return Err("not found");
}

let result = find_employee_by_id(3);
match result {
    Ok(name) => println(f"Found: {name}"),
    Err(msg) => println(f"Error: {msg}"),
};

let result2 = find_employee_by_id(99);
match result2 {
    Ok(name) => println(f"Found: {name}"),
    Err(msg) => println(f"Error: {msg}"),
};
println("");

// Compound assignment
mut counter = 0;
counter += 5;
counter *= 2;
counter -= 3;
println(f"Counter: {counter}");
println("");

// Function composition
fn double(x: int) -> int {
    return x * 2;
}

fn add_ten(x: int) -> int {
    return x + 10;
}

let piped = add_ten(double(5));
println(f"Composed result: {piped}");
println("");

// For-in over string (tests Bug 2: character iteration)
println("--- Characters ---");
for ch in "Carv" {
    println(f"  {ch}");
}
println("");

// Arrays of primitives (tests Bug 3: array in f-string)
let numbers = [1, 2, 3, 4, 5];
println(f"Numbers: {numbers}");
println(f"Length: {len(numbers)}");
println("");

// For-in over array
println("--- Array elements ---");
for n in numbers {
    println(f"  {n}");
}
println("");

// Float arrays
let prices = [9.99, 19.99, 29.99];
println(f"Prices: {prices}");
println("");

// String arrays
let tags = ["engineering", "marketing"];
println(f"Tags: {tags}");
println("");

// Bool arrays
let flags = [true, false, true];
println(f"Flags: {flags}");
println("");

println("=== Done ===");
